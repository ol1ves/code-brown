# Required: cookies exported from a logged-in burner X account session.
# DevTools → Application → Cookies → x.com → copy values for auth_token and ct0.
X_AUTH_TOKEN=
X_CT0=

# Optional: overrides the public web-app bearer hardcoded in xscraper/config.py.
# Set this only if X rotates the public web-app bearer constant.
# X_BEARER=
